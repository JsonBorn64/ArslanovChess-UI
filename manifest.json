{
  "manifest_version": 3,
  "name": "Free Chess Analyzer with brilliants, ratings",
  "version": "0.30",
  "description": "One-click analysis of finished Lichess, Endgame and Chess.com games: rating, accuracy, brilliants. Not affiliated with Chess.com.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.c4355.com/*",
        "https://www.chess.com/*",
        "https://lichess.org/*",
        "https://endgame.ai/*"
      ],
      "js": [
        "content.js",
        "chess.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "xaker6444@gmail.com"
    }
  }
}